# These are GitHub Actions repository secrets, not values to commit here.
STATE_ENCRYPTION_KEY=<64-hex-character-key-from-scripts/generate-key.sh>
WEB_ACCESS_USER=cloudandroid
WEB_ACCESS_PASSWORD=<at-least-16-random-characters>

# Defaults are defined in .github/workflows/android.yml
ANDROID_API=37.1
ANDROID_RUNTIME_MINUTES=270
STATE_CHUNK_MIB=1800
